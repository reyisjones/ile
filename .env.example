# =====================================================================
# ILE — IKIGAI Learning Engine
# Environment configuration. Copy to `.env` and edit values.
# NEVER commit `.env` to version control.
# =====================================================================

# ---- Core Postgres ----
POSTGRES_DB=ile
POSTGRES_USER=ile_admin
POSTGRES_PASSWORD=pgp@ssw@rd
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=59D90ABF-D157-4B4A-AA96-8225FB86AEE9
# JWT access token lifetime (minutes)
API_ACCESS_TOKEN_MINUTES=1440
# Single-user mode skips auth for local personal use. Set false for multi-user.
API_SINGLE_USER_MODE=true
API_LOG_LEVEL=info

# ---- Metabase ----
MB_DB_FILE=/metabase-data/metabase.db
METABASE_PORT=3000

# ---- Local LLM (Ollama) ----
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
# Default models pulled/used for coaching, quizzes, summarization
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Automation (n8n, optional profile) ----
N8N_PORT=5678
N8N_BASIC_AUTH_USER=ile
N8N_BASIC_AUTH_PASSWORD=n8np@ssw@rd

# ---- Backups ----
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400

# ---- Paths ----
VAULT_PATH=./vault
